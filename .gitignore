# SwiftPM build products. Regenerated by `swift build`; the whole directory is
# large and machine-specific.
.build/
.swiftpm/

# The assembled app bundle. `./build-app.sh` writes it from scratch every run, so
# there is nothing here worth keeping in history.
build/

# The icon set is a build intermediate: `build-app.sh` renders it, runs iconutil,
# and deletes it in the same pass.
*.iconset/

# macOS
.DS_Store
